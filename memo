#!/usr/bin/env python3
"""orkmem: permanent memory for AI agents.

  memo init                  create this memory; print the setup block
  memo wake [page [head]]    read rules, open items and current facts; run first
  memo note "..."            record one line (--rule, --user, --subject, --replaces ...)
  memo ask <words>           search: current entries first, outdated ones marked
  memo open <id>             one entry whole, with what it replaced and what replaced it
  memo drop <id> "why"       retire an entry that is wrong or outdated
  memo distinct <a> <b>      two rules the tidy prompt paired say different things
  memo guard [action]        does an active rule forbid this action (hook: JSON on stdin)
  memo import <optmem-dir>   add the OptMem memories (LOG.txt) not imported yet
  memo config [NAME=VALUE]   show or change the sizes

The memory lives in ~/.orkmem/memory, or in $MEMORY_DIR if set.
"""

import argparse
import datetime
import fcntl
import hashlib
import json
import math
import os
import re
import sys
from collections import Counter
from collections.abc import Callable, Iterable
from dataclasses import asdict, dataclass, field, replace
from enum import Enum
from typing import NoReturn

KNOBS = {"ENTRY_BYTES": 280, "PAGE_BYTES": 10000, "RULE_BYTES": 8000, "RECENT_LINES": 24, "ASK_LINES": 20, "HINTS": 3}
MEMORY_ENV, DEFAULT_DIR = "MEMORY_DIR", "~/.orkmem/memory"
LOG, HEAD, LOCK, CONFIG = "LOG.jsonl", "HEAD", ".lock", "config"
OPTMEM_LOG, OPTMEM_RECORD, OPTMEM_TIME = "LOG.txt", 320, "T00:00:00+00:00"
ID_HEX, SHORT, MIN_REF, DATE_CHARS = 16, 8, 4, 10
FRAME_BYTES = 400
ALIAS_MARK = "#"
WORD = re.compile(r"[a-z0-9][a-z0-9_.-]{2,}")
QUERY_SPLIT = re.compile(r"[\s|]+")
REGEX_SIGNS = re.compile(r"[\\^$.*+?()\[\]{}]")
TERM = re.compile(r"[a-z']+")
FACT_ATOM = re.compile(r"\d+(?:[.,:]\d+)*|[\w.-]*[/_][\w./-]*")
ATOM_TAIL = ".-/"
MODAL = frozenset({"never", "no", "not", "don't", "dont", "must", "always", "only", "without"})
EXIT_DAMAGED, EXIT_BLOCKED = 1, 3
HOOK_EVENT, DENY, NO_DECISION = "PreToolUse", "deny", "{}"

WAKE_HEAD = "orkmem, page {page} of {pages}, as of {head} ({count} entries)"
RULES_HEAD = "RULES ({count}), newest first. Where two rules conflict, the newer one wins."
SECTION = "{name} ({count})"
OPEN_SECTION, NOW_SECTION, RECENT_SECTION = "OPEN", "NOW", "RECENT"
MORE, END = "More: memo wake {page} {head}", "End of memory."
ENTRY_LINE = "  {id} {kind}{subject} {text}  ({by}, {day}){enforced}{outdated}"
SUBJECT_TAG, ENFORCED_TAG, OUTDATED_TAG = " {subject}:", " (enforced)", "  [outdated, now {id}]"
AGED_LINE = "{line}  ({age})"
SEEN_TODAY, SEEN_AGO = "seen today", "seen {days}d ago"
TIDY_HEAD = "TIDY: rules fill {size} of {budget} bytes and these two overlap. Do this before your next action:"
TIDY_MERGE = ('  Same rule: memo note --rule{user} --replaces {a} --replaces {b} "<one line that keeps every never, no, '
              'not, must, always and only of both>"')
TIDY_DISTINCT = "  Different rules: memo distinct {a} {b}"
USER_FLAG = " --user"
SAVED, REPLACES_LINE = "Saved {id}", "  replaces {id} {text}"
CLOSEST = 'Closest earlier. If your note makes one outdated: memo drop <id> "replaced by {id}"'
ASK_HEAD = "{total} matches, showing {first}-{last}, current first"
REPLACED_LINE = "      replaced {id} {text} ({day})"
ASK_MORE = 'more: memo ask "{query}" --page {page}'
NO_MATCH = "No match."
OPEN_HEAD, OPEN_ALIAS = "{id}  {kind} by {by} at {at}", "  (OptMem {alias})"
OPEN_TEXT, OPEN_FIELD, OPEN_NOW = "  {text}", "  {name}: {value}", "  now: {id} {text}"
DROPPED = "Dropped {id} ({drop})"
DISTINCT_TEXT = "rules {a} and {b} say different things"
BLOCKED = "Blocked by rule {id}: {text}"
DENY_REASON = "Memory rule {id}: {text}"
IMPORTED = "Imported {added} new memories ({had} were already here). Restate standing rules with: memo note --rule --user"
CONFIG_LINE = "{name:<13} {value}"

NO_MEMORY = "No memory at {dir}. To create one: memo init. To use another: set MEMORY_DIR."
DAMAGED = "The memory is damaged: {why}. Nothing was read or written. Restore LOG.jsonl from a copy that ends at HEAD."
UNREADABLE = "unreadable line: {error}"
BROKEN_CHAIN = "entry {n} does not follow entry {before}"
LOST_TAIL = "HEAD {head} is not in the log: it lost its tail or was rewritten"
AMBIGUOUS = "{ref} matches {count} entries. Use an id printed by wake, ask or note."
ALREADY_OUTDATED = "{id} is already outdated: now {now}. Replace that one instead."
USER_RULE = "{id} is a rule the user stated. It ends only when the user changes it: memo note --rule --user --replaces {id} \"...\""
ONE_LINE = "A note is one non-empty line."
TOO_LONG = "Too long: {size} bytes, limit {limit}. Split it, or say it shorter."
FACT_FLAGS = "--subject and --open are for facts; a rule holds until replaced or dropped."
RULE_FLAGS = "--guard is for rules."
MERGE_DROPS = "The merge drops {words}: keep every never, no, not, must, always and only of the rules it merges."
MERGE_ADDS = "The merge adds {atoms}, which none of the merged rules says."
NO_TERMS = "Ask with words, for example: memo ask deploy version"
NO_ENTRY = "No entry {head}. Run: memo wake"
NO_PAGE = "No page {page}: the memory has {pages}. Run: memo wake"
NOT_TWO_RULES = "distinct takes two current rules."
GUARD_FAILED = "orkmem guard could not check this action ({error}). Denying rather than failing open."
CONFIG_USAGE = "usage: memo config NAME=NUMBER, NAME one of {names}"
UNKNOWN_ARGS = "unrecognized arguments: {args}"


class Kind(str, Enum):
    RULE = "rule"
    FACT = "fact"


class By(str, Enum):
    USER = "user"
    AGENT = "agent"


class Damaged(Exception):
    pass


@dataclass(frozen=True)
class Entry:
    at: str
    kind: Kind
    by: By
    text: str
    n: int = 0
    prev: str = ""
    subject: str | None = None
    until: str | None = None  # written by the first release; kept so those entries still verify
    guard: str | None = None
    open: bool = False
    drop: bool = False
    replaces: tuple[str, ...] = ()
    alias: str | None = None
    pair: tuple[str, ...] = ()
    id: str = field(default="", compare=False)

    def body(self) -> dict[str, object]:
        raw = {**asdict(self), "kind": self.kind.value, "by": self.by.value, "replaces": list(self.replaces), "pair": list(self.pair)}
        return {k: v for k, v in raw.items() if k != "id" and v is not None and v is not False and v != []}

    @property
    def day(self) -> str:
        return self.at[:DATE_CHARS]

    @property
    def short(self) -> str:
        return self.id[:SHORT]

    @staticmethod
    def parse(line: str) -> "Entry":
        try:
            raw = json.loads(line)
            return Entry(**{**raw, "kind": Kind(raw["kind"]), "by": By(raw["by"]),
                            "replaces": tuple(raw.get("replaces", ())), "pair": tuple(raw.get("pair", ()))})
        except (ValueError, TypeError, KeyError) as e:
            raise Damaged(UNREADABLE.format(error=e)) from e


class Args(argparse.Namespace):
    cmd: str
    page: int
    head: str | None
    text: str
    rule: bool
    user: bool
    open: bool
    subject: str | None
    guard: str | None
    replaces: list[str]
    query: list[str]
    ref: str
    around: int
    why: str
    first: str
    second: str
    action: list[str]
    optmem_dir: str
    pairs: list[str]


def digest(body: dict[str, object]) -> str:
    canon = json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(canon.encode()).hexdigest()[:ID_HEX]


def now() -> str:
    return datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds")


def die(msg: str) -> NoReturn:
    print(msg, file=sys.stderr)
    sys.exit(EXIT_DAMAGED)


def emit(lines: Iterable[str]) -> None:
    text = "\n".join(lines)
    if text:
        print(text)


def home(path: str) -> str:
    return path.replace(os.path.expanduser("~"), "~", 1)


def memory_dir() -> str:
    return os.path.expanduser(os.environ.get(MEMORY_ENV) or DEFAULT_DIR)


def store() -> str:
    d = memory_dir()
    if not os.path.isfile(os.path.join(d, LOG)):
        die(NO_MEMORY.format(dir=d))
    return d


def knobs(d: str) -> dict[str, int]:
    out = dict(KNOBS)
    path = os.path.join(d, CONFIG)
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                name, eq, value = line.split("#")[0].partition("=")
                if eq and name.strip() in KNOBS and value.strip().isdigit():
                    out[name.strip()] = int(value)
    return out


def read(d: str) -> list[Entry]:
    with open(os.path.join(d, HEAD), encoding="utf-8") as f:
        head = f.read().strip()
    with open(os.path.join(d, LOG), encoding="utf-8") as f:
        entries = [Entry.parse(line) for line in f.read().split("\n")[:-1]]
    prev = ""
    for i, e in enumerate(entries):
        if e.n != i or e.prev != prev or digest(e.body()) != e.id:
            raise Damaged(BROKEN_CHAIN.format(n=i, before=i - 1))
        prev = e.id
    if head and head not in {e.id for e in entries}:
        raise Damaged(LOST_TAIL.format(head=head))
    return entries


def sync_write(path: str, data: str) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def append(d: str, drafts: list[Entry]) -> list[Entry]:
    with open(os.path.join(d, LOCK), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = os.path.join(d, LOG)
        with open(path, "rb+") as f:
            f.truncate(f.read().rfind(b"\n") + 1)
        entries = read(d)
        out, prev = [], entries[-1].id if entries else ""
        for k, draft in enumerate(drafts):
            e = replace(draft, n=len(entries) + k, prev=prev)
            e = replace(e, id=digest(e.body()))
            out.append(e)
            prev = e.id
        with open(path, "a", encoding="utf-8") as f:
            f.writelines(json.dumps({"id": e.id, **e.body()}, ensure_ascii=False) + "\n" for e in out)
            f.flush()
            os.fsync(f.fileno())
        sync_write(os.path.join(d, HEAD), prev)
        return out


@dataclass
class Memory:
    entries: list[Entry]
    replaced_by: dict[str, str]
    by_id: dict[str, Entry]
    distinct: set[frozenset[str]]

    @staticmethod
    def fold(entries: list[Entry]) -> "Memory":
        replaced_by: dict[str, str] = {}
        latest: dict[str, str] = {}
        for e in entries:
            for target in e.replaces:
                replaced_by[target] = e.id
            if e.kind is Kind.FACT and e.subject and not e.drop:
                if e.subject in latest:
                    replaced_by.setdefault(latest[e.subject], e.id)
                latest[e.subject] = e.id
        return Memory(entries, replaced_by, {e.id: e for e in entries}, {frozenset(e.pair) for e in entries if e.pair})

    def current(self, e: Entry) -> bool:
        return not e.drop and e.id not in self.replaced_by

    def rules(self) -> list[Entry]:
        return [e for e in reversed(self.entries) if e.kind is Kind.RULE and self.current(e)]

    def final(self, e: Entry) -> Entry:
        while e.id in self.replaced_by:
            e = self.by_id[self.replaced_by[e.id]]
        return e

    def resolve(self, ref: str) -> Entry:
        by_alias = ref.startswith(ALIAS_MARK)
        hits = [e for e in self.entries if (e.alias == ref if by_alias else len(ref) >= MIN_REF and e.id.startswith(ref))]
        if len(hits) != 1:
            die(AMBIGUOUS.format(ref=ref, count=len(hits)))
        return hits[0]

    def current_or_die(self, e: Entry) -> None:
        if not self.current(e):
            die(ALREADY_OUTDATED.format(id=e.short, now=self.final(e).short))


def age(e: Entry) -> str:
    days = (datetime.date.fromisoformat(now()[:DATE_CHARS]) - datetime.date.fromisoformat(e.day)).days
    return SEEN_TODAY if days == 0 else SEEN_AGO.format(days=days)


def show(e: Entry, mem: Memory) -> str:
    return ENTRY_LINE.format(
        id=e.short, kind=e.kind.value, subject=SUBJECT_TAG.format(subject=e.subject) if e.subject else "", text=e.text,
        by=e.by.value, day=e.day, enforced=ENFORCED_TAG if e.guard else "",
        outdated="" if mem.current(e) else OUTDATED_TAG.format(id=mem.final(e).short))


def pages(lines: list[str], budget: int) -> list[list[str]]:
    out: list[list[str]] = [[]]
    size = 0
    for line in lines:
        n = len(line.encode()) + 1
        if out[-1] and size + n > budget - FRAME_BYTES:
            out.append([])
            size = 0
        out[-1].append(line)
        size += n
    return out


def words(text: str) -> set[str]:
    return set(WORD.findall(text.lower()))


def overlap(df: Counter[str], size: int, a: str, b: str) -> float:
    return sum(math.log(size / df[w]) for w in words(a) & words(b))


def closest(pool: list[Entry], text: str, n: int) -> list[Entry]:
    df = Counter(w for e in pool for w in words(e.text))
    scored = [(overlap(df, len(pool), text, e.text), e) for e in pool]
    return [e for s, e in sorted(scored, key=lambda x: (-x[0], -x[1].n)) if s > 0][:n]


def tidy_lines(mem: Memory, budget: int) -> list[str]:
    rules = mem.rules()
    size = sum(len(show(e, mem).encode()) + 1 for e in rules)
    if size <= budget:
        return []
    df = Counter(w for e in rules for w in words(e.text))
    pairs = [(overlap(df, len(rules), a.text, b.text), a, b) for i, a in enumerate(rules) for b in rules[i + 1:]
             if frozenset((a.id, b.id)) not in mem.distinct]
    best = max(pairs, key=lambda p: p[0], default=None)
    if best is None or best[0] <= 0:
        return []
    _, a, b = best
    user = USER_FLAG if By.USER in (a.by, b.by) else ""
    return [TIDY_HEAD.format(size=size, budget=budget), show(a, mem), show(b, mem),
            TIDY_MERGE.format(user=user, a=a.short, b=b.short), TIDY_DISTINCT.format(a=a.short, b=b.short)]


def merge_problem(text: str, olds: tuple[Entry, ...]) -> str | None:
    lost = {t for o in olds for t in TERM.findall(o.text.lower()) if t in MODAL} - set(TERM.findall(text.lower()))
    known = {m.lower().rstrip(ATOM_TAIL) for o in olds for m in FACT_ATOM.findall(o.text)}
    invented = {m.lower().rstrip(ATOM_TAIL) for m in FACT_ATOM.findall(text)} - known
    if lost:
        return MERGE_DROPS.format(words=", ".join(sorted(lost)))
    if invented:
        return MERGE_ADDS.format(atoms=", ".join(sorted(invented)))
    return None


def check_text(text: str, limit: int) -> str:
    text = text.strip()
    if not text or "\n" in text or "\r" in text:
        die(ONE_LINE)
    if len(text.encode()) > limit:
        die(TOO_LONG.format(size=len(text.encode()), limit=limit))
    return text


def cmd_wake(d: str, args: Args) -> None:
    k, entries = knobs(d), read(d)
    if args.head:
        cut = [i for i, e in enumerate(entries) if e.id == args.head]
        if not cut:
            die(NO_ENTRY.format(head=args.head))
        entries = entries[: cut[0] + 1]
    mem = Memory.fold(entries)
    facts = [e for e in entries if mem.current(e) and e.kind is Kind.FACT]
    opened = [e for e in facts if e.open]
    latest = sorted((e for e in facts if e.subject and not e.open), key=lambda e: e.subject or "")
    recent = [e for e in entries if not e.drop][-k["RECENT_LINES"]:]
    rules = mem.rules()
    lines = [RULES_HEAD.format(count=len(rules)), *(show(e, mem) for e in rules)]
    lines += [SECTION.format(name=OPEN_SECTION, count=len(opened)), *(show(e, mem) for e in opened)]
    lines += [SECTION.format(name=NOW_SECTION, count=len(latest)), *(AGED_LINE.format(line=show(e, mem), age=age(e)) for e in latest)]
    lines += [SECTION.format(name=RECENT_SECTION, count=len(recent)), *(show(e, mem) for e in recent)]
    lines += tidy_lines(mem, k["RULE_BYTES"])
    book = pages(lines, k["PAGE_BYTES"])
    if not 1 <= args.page <= len(book):
        die(NO_PAGE.format(page=args.page, pages=len(book)))
    head = entries[-1].id if entries else "-"
    print(WAKE_HEAD.format(page=args.page, pages=len(book), head=head, count=len(entries)))
    print("\n".join(book[args.page - 1]))
    print(MORE.format(page=args.page + 1, head=head) if args.page < len(book) else END)


def cmd_note(d: str, args: Args) -> None:
    k, entries = knobs(d), read(d)
    mem = Memory.fold(entries)
    kind = Kind.RULE if args.rule else Kind.FACT
    if kind is Kind.RULE and (args.subject or args.open):
        die(FACT_FLAGS)
    if kind is Kind.FACT and args.guard:
        die(RULE_FLAGS)
    if args.guard:
        re.compile(args.guard)
    targets = tuple(mem.resolve(r) for r in args.replaces)
    for t in targets:
        mem.current_or_die(t)
        if t.kind is Kind.RULE and t.by is By.USER and not args.user:
            die(USER_RULE.format(id=t.short))
    text = check_text(args.text, k["ENTRY_BYTES"])
    if kind is Kind.RULE and sum(t.kind is Kind.RULE for t in targets) > 1:
        problem = merge_problem(text, targets)
        if problem:
            die(problem)
    by = By.USER if args.user else By.AGENT
    draft = Entry(now(), kind, by, text, subject=args.subject, guard=args.guard, open=args.open, replaces=tuple(t.id for t in targets))
    e = append(d, [draft])[0]
    after = Memory.fold([*entries, e])
    print(SAVED.format(id=e.id))
    emit(REPLACES_LINE.format(id=old.short, text=old.text) for old in entries if after.replaced_by.get(old.id) == e.id)
    near = closest([x for x in entries if after.current(x) and x.kind is kind], e.text, k["HINTS"])
    if near:
        emit([CLOSEST.format(id=e.short), *(show(x, after) for x in near)])
    emit(tidy_lines(after, k["RULE_BYTES"]))


def cmd_ask(d: str, args: Args) -> None:
    k, entries = knobs(d), read(d)
    mem = Memory.fold(entries)
    terms = {REGEX_SIGNS.sub("", t) for q in args.query for t in QUERY_SPLIT.split(q.lower()) if not t.startswith("-")} - {""}
    if not terms:
        die(NO_TERMS)

    def score(e: Entry) -> int:
        return sum(t in f"{e.text} {e.subject or ''}".lower() for t in terms)

    hits = [e for s, e in sorted(((score(e), e) for e in entries if not e.drop), key=lambda x: (-x[0], -x[1].n)) if s > 0]
    if not hits:
        print(NO_MATCH)
        return
    shown = {e.id for e in hits if mem.current(e)}
    under: dict[str, list[Entry]] = {}
    items = []
    for e in hits:
        final = mem.final(e)
        if e.id != final.id and final.id in shown:
            under.setdefault(final.id, []).append(e)
        else:
            items.append(e)
    per = k["ASK_LINES"]
    first = (args.page - 1) * per
    page = items[first: first + per]
    print(ASK_HEAD.format(total=len(hits), first=first + 1, last=first + len(page)))
    for e in page:
        print(show(e, mem))
        emit(REPLACED_LINE.format(id=old.short, text=old.text, day=old.day) for old in under.get(e.id, []))
    if first + per < len(items):
        print(ASK_MORE.format(query=" ".join(args.query), page=args.page + 1))


def cmd_open(d: str, args: Args) -> None:
    entries = read(d)
    mem = Memory.fold(entries)
    e = mem.resolve(args.ref)
    print(OPEN_HEAD.format(id=e.id, kind=e.kind.value, by=e.by.value, at=e.at) + (OPEN_ALIAS.format(alias=e.alias) if e.alias else ""))
    print(OPEN_TEXT.format(text=e.text))
    emit(OPEN_FIELD.format(name=name, value=value) for name, value in (("subject", e.subject), ("guard", e.guard)) if value)
    if not mem.current(e):
        print(OPEN_NOW.format(id=mem.final(e).short, text=mem.final(e).text))
    emit(REPLACED_LINE.format(id=old.short, text=old.text, day=old.day) for old in entries if mem.replaced_by.get(old.id) == e.id)
    if args.around:
        emit(show(x, mem) for x in entries[max(0, e.n - args.around): e.n + args.around + 1])


def cmd_drop(d: str, args: Args) -> None:
    mem = Memory.fold(read(d))
    target = mem.resolve(args.ref)
    mem.current_or_die(target)
    if target.kind is Kind.RULE and target.by is By.USER:
        die(USER_RULE.format(id=target.short))
    why = check_text(args.why, knobs(d)["ENTRY_BYTES"])
    e = append(d, [Entry(now(), target.kind, By.AGENT, why, drop=True, replaces=(target.id,))])[0]
    print(DROPPED.format(id=target.short, drop=e.id))


def cmd_distinct(d: str, args: Args) -> None:
    mem = Memory.fold(read(d))
    a, b = mem.resolve(args.first), mem.resolve(args.second)
    if not all(e.kind is Kind.RULE and mem.current(e) for e in (a, b)):
        die(NOT_TWO_RULES)
    e = append(d, [Entry(now(), Kind.FACT, By.AGENT, DISTINCT_TEXT.format(a=a.short, b=b.short), pair=(a.id, b.id))])[0]
    print(SAVED.format(id=e.id))
    emit(tidy_lines(Memory.fold([*mem.entries, e]), knobs(d)["RULE_BYTES"]))


def blocking(d: str, action: str) -> list[Entry]:
    mem = Memory.fold(read(d))
    return [e for e in mem.entries if mem.current(e) and e.guard and re.search(e.guard, action, re.IGNORECASE)]


def cmd_guard(d: str, args: Args) -> None:
    if args.action:
        hits = blocking(d, " ".join(args.action))
        emit(BLOCKED.format(id=e.short, text=e.text) for e in hits)
        sys.exit(EXIT_BLOCKED if hits else 0)
    try:
        tool_input = json.loads(sys.stdin.read())["tool_input"]
        command = tool_input.get("command")
        hits = blocking(d, command if isinstance(command, str) else json.dumps(tool_input))
        reason = "; ".join(DENY_REASON.format(id=e.short, text=e.text) for e in hits)
    except (ValueError, KeyError, TypeError, Damaged) as err:
        reason = GUARD_FAILED.format(error=err)
    if not reason:
        print(NO_DECISION)
        return
    decision = {"hookEventName": HOOK_EVENT, "permissionDecision": DENY, "permissionDecisionReason": reason}
    print(json.dumps({"hookSpecificOutput": decision}))


def cmd_import(d: str, args: Args) -> None:
    with open(os.path.join(args.optmem_dir, OPTMEM_LOG), "rb") as f:
        data = f.read()
    have = {e.alias for e in read(d) if e.alias}
    drafts = []
    for i in range(len(data) // OPTMEM_RECORD):
        alias, _, rest = data[i * OPTMEM_RECORD: (i + 1) * OPTMEM_RECORD].decode().rstrip().partition(" ")
        day, _, text = rest.partition(" ")
        if alias not in have:
            drafts.append(Entry(day + OPTMEM_TIME, Kind.FACT, By.AGENT, text, alias=alias))
    added = append(d, drafts) if drafts else []
    print(IMPORTED.format(added=len(added), had=len(have)))


def cmd_config(d: str, args: Args) -> None:
    k = knobs(d)
    for pair in args.pairs:
        name, _, value = pair.partition("=")
        if name not in KNOBS or not value.isdigit():
            die(CONFIG_USAGE.format(names=", ".join(KNOBS)))
        k[name] = int(value)
    if args.pairs:
        sync_write(os.path.join(d, CONFIG), "".join(f"{name}={value}\n" for name, value in k.items()))
    emit(CONFIG_LINE.format(name=name, value=value) for name, value in k.items())


TEMPLATE = """\
## Memory

Your memory is orkmem. The tool is `{memo}`; the memory is in `{data}`.

### At startup and after every compaction (mandatory)

Your first action, and your first action after a compaction: `{memo} wake`.
Read page after page until one ends with "End of memory." Every RULE applies,
however old; where two conflict, the newer one wins. A NOW fact is the last thing
seen: check it again before you act on it. When the memory shows a TIDY request,
do it before your next action, the same way you would answer any other request.

### While working: write it down (mandatory)

- `{memo} note --rule --user "..."` when the user says how things must be done.
- `{memo} note --subject <topic> "..."` for a fact that can change (a version, a
  status, a place); a newer note on the same subject replaces the older one.
- `{memo} note "..."` for anything else worth keeping: a decision and its reason,
  a result, a lesson. One line, at most {chars} bytes. Do not repeat what is there.
- `--replaces <id>` when a note corrects an earlier one; `{memo} drop <id> "why"`
  when one is wrong. When `note` lists a closest earlier entry your note makes
  outdated, drop it. A rule the user stated changes only when the user changes it.

### When you need something old

`{memo} ask <words>` lists current entries first and marks outdated ones.
`{memo} open <id>` shows one entry whole, with what it replaced and what replaced it.

The files in `{data}` change only through the tool; it refuses a damaged memory.

### Helpers you start

Memory belongs to the main session. Tell any helper agent you start: `Do not run memo.`
"""


def cmd_init() -> None:
    d = memory_dir()
    os.makedirs(d, exist_ok=True)
    for name in (LOG, HEAD):
        open(os.path.join(d, name), "a").close()
    print(TEMPLATE.format(memo=home(os.path.realpath(__file__)), data=home(d), chars=knobs(d)["ENTRY_BYTES"]))


COMMANDS: dict[str, Callable[[str, Args], None]] = {
    "wake": cmd_wake, "note": cmd_note, "ask": cmd_ask, "open": cmd_open, "drop": cmd_drop,
    "distinct": cmd_distinct, "guard": cmd_guard, "import": cmd_import, "config": cmd_config,
}


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="memo", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init")
    w = sub.add_parser("wake")
    w.add_argument("page", nargs="?", type=int, default=1)
    w.add_argument("head", nargs="?")
    n = sub.add_parser("note")
    n.add_argument("text")
    for flag in ("--rule", "--user", "--open"):
        n.add_argument(flag, action="store_true")
    for flag in ("--subject", "--guard"):
        n.add_argument(flag)
    n.add_argument("--replaces", action="append", default=[])
    q = sub.add_parser("ask")
    q.add_argument("query", nargs="+")
    q.add_argument("--page", type=int, default=1)
    o = sub.add_parser("open")
    o.add_argument("ref")
    o.add_argument("--around", type=int, default=0)
    r = sub.add_parser("drop")
    r.add_argument("ref")
    r.add_argument("why")
    s = sub.add_parser("distinct")
    s.add_argument("first")
    s.add_argument("second")
    sub.add_parser("guard").add_argument("action", nargs="*")
    sub.add_parser("import").add_argument("optmem_dir")
    sub.add_parser("config").add_argument("pairs", nargs="*")
    return p


def main() -> None:
    p = parser()
    args, extra = p.parse_known_args(namespace=Args())
    if extra and args.cmd != "ask":
        p.error(UNKNOWN_ARGS.format(args=" ".join(extra)))
    if args.cmd == "init":
        cmd_init()
        return
    try:
        COMMANDS[args.cmd](store(), args)
    except Damaged as e:
        die(DAMAGED.format(why=e))


if __name__ == "__main__":
    main()
